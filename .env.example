# Copy this file to .env and fill in the values. .env is NOT tracked in git:
# it holds real credentials and lives only on the machine running the stack.
# Under docker-compose it is injected into the web container via env_file;
# when running flask_site.py directly, website/__init__.py loads it itself.

FLASK_APP=flask_site.py
FLASK_DEBUG=0
SQL_HOST=db
SQL_PORT=3306
DATABASE=mysql

# Flask session signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Primary MySQL server (Processing_Data, db_killdisk, Ecommerce, Validation).
PHR_DB_HOST=
PHR_DB_USER=
PHR_DB_PASSWORD=

# Aiken Workbench server (awbc_db).
PHR_AIKEN_DB_HOST=
PHR_AIKEN_DB_USER=
PHR_AIKEN_DB_PASSWORD=

# SuperWiper server (superwiper).
PHR_SUPERWIPER_DB_HOST=
PHR_SUPERWIPER_DB_USER=
PHR_SUPERWIPER_DB_PASSWORD=
